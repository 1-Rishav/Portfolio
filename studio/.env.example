# Copy this file to studio/.env (git-ignored) and fill it in. The Sanity CLI loads it automatically.
#
# Only SANITY_STUDIO_-prefixed variables are bundled into the browser, so never put a token under that prefix.

# Project ID: manage.sanity.io > your project - a short lowercase id such as "abc12xyz".
# Not a secret (it appears in every public request URL). The same id goes into client/.env as VITE_SANITY_PROJECT_ID.
SANITY_STUDIO_PROJECT_ID=your_project_id_here

# Dataset name. The plan uses one public dataset called "production" (this is also the default if you leave it out).
SANITY_STUDIO_DATASET=production
