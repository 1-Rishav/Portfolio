# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Same Client ID as the server's GOOGLE_CLIENT_ID - this one is safe to expose
# in frontend code (Client IDs are public identifiers, unlike Client Secrets,
# which this flow never needs at all).
#
# Copy this file to .env, fill in the value below, and restart the dev server.
# Until it's set, the "Continue with Google" button simply doesn't render -
# email/password login still works normally either way.
VITE_GOOGLE_CLIENT_ID=your_client_id_here
