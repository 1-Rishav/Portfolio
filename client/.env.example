# API base URL - defaults to the deployed production server if this isn't
# set, so the live site works with zero config. For local development,
# uncomment and point this at your local server instead.
# VITE_API_BASE_URL=http://localhost:3001/

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Same Client ID as the server's GOOGLE_CLIENT_ID - this one is safe to expose
# in frontend code (Client IDs are public identifiers, unlike Client Secrets,
# which this flow never needs at all).
#
# Copy this file to .env, fill in the value below, and restart the dev server.
# Until it's set, the "Continue with Google" button simply doesn't render -
# email/password login still works normally either way.
VITE_GOOGLE_CLIENT_ID=your_client_id_here

# Sanity CMS - optional. Until a real project id is set the site simply keeps
# showing its built-in content, exactly as before.
#
# Public, read-only content access straight from the browser (see
# docs/CMS_INTEGRATION_PLAN.md). The project id is a public identifier - it is
# in every request URL - but never put a Sanity *token* in a VITE_ variable:
# Vite ships every VITE_ variable to the browser.
#
# Vite inlines these when the site is BUILT, so for the live site set them in
# Vercel (Project Settings > Environment Variables) and redeploy. For local
# development copy this file to .env and restart the dev server.
#
# Project ID: manage.sanity.io > your project - a short lowercase id such as
# "abc12xyz". The same id goes into studio/.env as SANITY_STUDIO_PROJECT_ID.
VITE_SANITY_PROJECT_ID=your_project_id_here
# Dataset name ("production" if left out).
VITE_SANITY_DATASET=production
# Optional: a different Sanity API version (a date). The default lives in
# src/utils/sanityClient.js.
# VITE_SANITY_API_VERSION=2026-05-04
